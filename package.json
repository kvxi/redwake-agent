{
  "name": "redwake-agent",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "module": "source/cli.ts",
  "bin": {
    "rwa": "./source/cli.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kvxi/redwake-agent.git"
  },
  "scripts": {
    "start": "bun run source/cli.ts",
    "build": "mkdir -p dist && bun build ./source/cli.ts --compile --minify --outfile ./dist/rwa",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "cheerio": "^1.0.0",
    "openai": "^7.7.0",
    "string-width": "^7.2.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/turndown": "^5.0.5",
    "typescript": "^7.0.2"
  }
}
